manifest {
    name = 'minimap2-bambu-qc'
    nextflowVersion = '>=24.10.0'
}

// No machine-specific paths, input folders, genomes or sample names.
params {
    fasta = null
    gtf = null
    direct_rna = null
    cdna = null
    rscript = null
    outdir = null
    without_annotations = false
    qc_min_primary_reads = 10000
    qc_min_mapping_pct = 50
    qc_short_length = 200
    qc_max_short_pct = 90
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
}
executor.queueSize = 1
workDir = params.outdir ? "${params.outdir}/work" : 'work'

report {
    enabled = params.outdir != null
    file = "${params.outdir}/scenarios/${params.without_annotations ? 'unannotated' : 'annotated'}/execution/report.html"
    overwrite = true
}
trace {
    enabled = params.outdir != null
    file = "${params.outdir}/scenarios/${params.without_annotations ? 'unannotated' : 'annotated'}/execution/trace.tsv"
    overwrite = true
}
timeline {
    enabled = params.outdir != null
    file = "${params.outdir}/scenarios/${params.without_annotations ? 'unannotated' : 'annotated'}/execution/timeline.html"
    overwrite = true
}
